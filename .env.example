# ==============================================================================
# BarrierGuard Production Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual production/staging credentials.
# NEVER commit the real .env file with live secrets to GitHub!

# Application Environment
PROJECT_NAME="BarrierGuard - SIF Precursor Intelligence Engine"
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# In local development: defaults to sqlite:///barrierguard.db
# In production (Neon): copy your connection string from the Neon console:
DATABASE_URL=postgresql://<user>:<password>@<ep-xyz>.neon.tech/barrierguard?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Credentials
# ------------------------------------------------------------------------------
# Generate a strong 32+ character secret (e.g. via `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend domains
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. AI / NLP & LLM Provider Credentials (Optional)
# ------------------------------------------------------------------------------
# Options: MOCK (default offline rule engine), OPENAI, GEMINI, ANTHROPIC
LLM_PROVIDER=MOCK
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 5. Web Frontend (Vercel) Environment Variables
# ------------------------------------------------------------------------------
# Set this in your Vercel Project Settings -> Environment Variables:
VITE_API_URL=https://<your-backend>.onrender.com
VITE_API_BASE_URL=https://<your-backend>.onrender.com/api

# ------------------------------------------------------------------------------
# 6. Mobile App (Expo EAS) Environment Variables
# ------------------------------------------------------------------------------
# Set this in your eas.json or Expo dashboard for EAS builds:
EXPO_PUBLIC_API_URL=https://<your-backend>.onrender.com
