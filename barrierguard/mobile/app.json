    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0F172A",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.barrierguard.field",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
