# BarrierGuard Environment Configuration
PROJECT_NAME="BarrierGuard - SIF Precursor Intelligence Engine"
ENVIRONMENT=development

# Database Configuration
# Defaults to local SQLite if left empty; use PostgreSQL + pgvector in production
DATABASE_URL=sqlite:///barrierguard.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barrierguard

# Authentication
SECRET_KEY=barrierguard-sih-oil-super-secret-key-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Optional: application defaults to rich offline rule engine)
LLM_PROVIDER=MOCK
# LLM_PROVIDER=OPENAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# LLM_PROVIDER=GEMINI
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-1.5-flash

# Web Frontend Port
PORT=3000
# Backend API URL for Web & Mobile
VITE_API_BASE_URL=http://localhost:8000/api
